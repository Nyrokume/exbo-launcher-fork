<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>

<!-- RAM slider. The original drew the track/bar with BorderImage in code; here it is two CSS-styled regions. -->
<AnchorPane prefHeight="64.0" prefWidth="487.0" stylesheets="@../style/common.css,@../style/settings.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.settings.entries.ProgressionEntryController">
   <children>
      <Label fx:id="label" prefHeight="27.0" prefWidth="487.0" styleClass="settings-label" text="Label" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
      <Pane fx:id="progress" prefHeight="13.0" maxWidth="487.0" prefWidth="487.0" styleClass="progression-track" AnchorPane.bottomAnchor="22.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <Region fx:id="bar" prefHeight="13.0" styleClass="progression-bar" />
      </Pane>
      <Label fx:id="description" prefHeight="20.0" prefWidth="487.0" styleClass="settings-label" text="Label" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" />
   </children>
</AnchorPane>
