<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="24.0" prefWidth="478.0" stylesheets="@../style/common.css,@../style/settings.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.settings.entries.CheckBoxEntryController">
   <children>
      <CheckBox fx:id="checkBox" layoutY="2.0" mnemonicParsing="false" onAction="#onSelected" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
      <Label fx:id="label" styleClass="settings-label" onMouseClicked="#onLabelClicked" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="0.0" />
   </children>
</AnchorPane>
