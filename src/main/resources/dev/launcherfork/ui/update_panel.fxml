<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.LogoMark?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  Launcher self-update panel for the separate pre-main window, same blocks as auth_panel.fxml.
  Top block (card): vector logo, title, what is going on. Bottom block (card description): phase text + thin
  progress bar (indeterminate while checking), errors. Same fx:ids and controller as update.fxml.
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css" minWidth="420.0" prefWidth="460.0" minHeight="560.0" prefHeight="588.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.update.LauncherUpdateController">
    <VBox styleClass="zone-frame">
        <HBox styleClass="zone-titlebar" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" mnemonicParsing="false" />
        </HBox>

        <VBox styleClass="zone-top, zone-top-hero" VBox.vgrow="ALWAYS">
            <LogoMark styleClass="zone-logo" logoWidth="150" />
            <Label styleClass="zone-title" text="%fork.zone.update_title" wrapText="true" minHeight="-Infinity" />
            <Label styleClass="zone-description" text="%fork.zone.update_info" wrapText="true" minHeight="-Infinity" />
        </VBox>

        <VBox styleClass="zone-bottom, zone-bottom-status">
            <Label id="zoneStatus" fx:id="statusLabel" styleClass="zone-status" wrapText="true" minHeight="-Infinity" />
            <ProgressBar id="zoneProgress" fx:id="progressBar" styleClass="zone-progress" maxWidth="Infinity" />
            <VBox styleClass="zone-errors">
                <Label id="zoneErrorFirst" fx:id="errorFirst" styleClass="zone-error" wrapText="true" />
                <Label id="zoneErrorSecond" fx:id="errorSecond" styleClass="zone-error" wrapText="true" />
            </VBox>
        </VBox>
    </VBox>
    <!-- the bar shows the progress; the legacy spinner fx:id stays for the controller, never shown here -->
    <ProgressIndicator fx:id="rollingBar" visible="false" managed="false" />
</StackPane>
