<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.RamBar?>
<?import dev.launcherfork.ui.components.RamScale?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Settings: one scrollable column (Память, Поведение, Обновление, Язык). The header switch opens four
  pages that replace it: JVM, Туннель, Чувствительность, Аккаунты. Tunnel fills the settings viewport;
  the server list scrolls inside that page. The gear opens the column and, when the column is already
  open, closes settings. Profile «Аккаунты» still opens the account-swap page.

  Bound to SettingsStore by SettingsController, every change is saved. The page starts BELOW the nav row
  (main.fxml anchors it under the top bar; no page title: the sidebar already marks НАСТРОЙКИ as active).
  Small Bebas group labels, each over a subtle card (.card) whose rows all look the same: label left, control
  right, 34 px, thin separators between rows; no wrapping labels (long wording in tooltips). Full-width rows.
    ОПЕРАТИВНАЯ ПАМЯТЬ  "Выделено: 6 ГБ из 16 ГБ" (+ «Мало памяти останется системе» for the last 2 GB) + the
                        segmented RAM bar (like the original launcher, 2 GB .. the whole memory) + min / max captions
                        under the selectable range (RamScale).
    ПОВЕДЕНИЕ           auto-exit and P2P as segmented controls (accent on the selected part), then switches.
    ОБНОВЛЕНИЕ          speed limits (download / upload fields). ЯЗЫК: Русский / English.
    ТУННЕЛЬ             own page, the whole settings viewport. Region switch on the first row (same segmented
                        control as the other settings). The next row is Измерить, Найти лучший сервер,
                        then the rank mode. Nothing sits to the right of the mode control. The mode
                        control is an in-theme list, not a native combo. Each pool is one card: name and
                        count on the left, Исключить on the right of that title, then full-width rows
                        (name, client RTT, server RTT, sum). The server list scrolls; the toolbar does not.
    JVM                 preset cards (own page).
    АККАУНТЫ            one card per session (name and login on the left, key icon / Применить / Удалить on the right).
                        Cards and the name/save row stay inside the page; extra cards scroll above that row.
    ЧУВСТВИТЕЛЬНОСТЬ    own page, the whole settings viewport. One compact row (base, Посчитать, Записать),
                        then the scope table across the remaining width and height. The status line sits in that card.
-->
<AnchorPane fx:id="settingsRoot" id="settingsRoot" styleClass="settings-root" stylesheets="@style/layout.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.settings.SettingsController">
    <fx:define>
        <ToggleGroup fx:id="exitGroup"/>
        <ToggleGroup fx:id="p2pGroup"/>
        <ToggleGroup fx:id="languageGroup"/>
        <ToggleGroup fx:id="regionGroup"/>
    </fx:define>
    <ScrollPane fx:id="scroll" id="settingsScroll" styleClass="settings-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox fx:id="settingsContent" id="settingsContent" styleClass="settings-content">
            <VBox fx:id="launcherPage" styleClass="settings-page">
            <!-- ОПЕРАТИВНАЯ ПАМЯТЬ -->
            <VBox fx:id="gameSection" id="settingsGame" styleClass="settings-group" maxWidth="Infinity">
                <Label fx:id="gameHeading" styleClass="settings-group-label,font-display" text="%settings.heading.ram" minHeight="-Infinity"/>
                <VBox fx:id="ramCard" styleClass="settings-card,card,zone-radius-md,ram-card">
                    <HBox styleClass="ram-head" alignment="CENTER_LEFT">
                        <Label fx:id="ramSummary" id="ramSummary" styleClass="ram-summary" minWidth="-Infinity"/>
                        <Label fx:id="ramWarning" id="ramWarning" styleClass="ram-warning" minWidth="-Infinity" visible="false"/>
                    </HBox>
                    <RamBar fx:id="ramBar" id="ramBar" maxWidth="Infinity" accessibleText="%settings.ram"/>
                    <RamScale fx:id="ramScale" id="ramScale" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- ПОВЕДЕНИЕ -->
            <VBox fx:id="behaviourSection" id="settingsBehaviour" styleClass="settings-group" maxWidth="Infinity">
                <Label fx:id="behaviourHeading" styleClass="settings-group-label,font-display" text="%settings.heading.behaviour" minHeight="-Infinity"/>
                <VBox fx:id="behaviourCard" styleClass="settings-card,card,zone-radius-md">
                    <HBox fx:id="exitRow" styleClass="settings-row" alignment="CENTER_LEFT">
                        <Label fx:id="exitLabel" styleClass="settings-label,row-label" text="%settings.exit.short" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="exitOnStart" styleClass="segment,zone-radius-sm" text="%settings.exit.game_start" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="exitOnGameExit" styleClass="segment,zone-radius-sm" text="%settings.exit.game_exit" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="exitNever" styleClass="segment,zone-radius-sm" text="%settings.exit.never" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="p2pRow" styleClass="settings-row" alignment="CENTER_LEFT">
                        <Label fx:id="p2pLabel" styleClass="settings-label,row-label" text="%settings.p2p.short" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="p2pAlways" styleClass="segment,zone-radius-sm" text="%settings.p2p.always" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="p2pNotMobile" styleClass="segment,zone-radius-sm" text="%settings.p2p.not_mobile" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="p2pNever" styleClass="segment,zone-radius-sm" text="%settings.p2p.never" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="startOnDownloadedRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.start_on_downloaded" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="startOnDownloadedToggle" styleClass="switch" accessibleText="%settings.start_on_downloaded"/>
                    </HBox>
                    <HBox fx:id="defenderRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.defender" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="defenderToggle" styleClass="switch" accessibleText="%settings.defender"/>
                    </HBox>
                    <HBox fx:id="animationsRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.animations" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="animationsToggle" styleClass="switch" accessibleText="%settings.animations"/>
                    </HBox>
                    <HBox fx:id="trayRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.tray" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="trayToggle" styleClass="switch" accessibleText="%settings.tray"/>
                    </HBox>
                    <HBox fx:id="autostartRow" styleClass="settings-row,last,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.run_on_start" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="autostartToggle" styleClass="switch" accessibleText="%settings.run_on_start"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ОБНОВЛЕНИЕ -->
            <VBox fx:id="updatesSection" id="settingsUpdates" styleClass="settings-group" maxWidth="Infinity">
                <Label fx:id="updatesHeading" styleClass="settings-group-label,font-display" text="%settings.heading.updates" minHeight="-Infinity"/>
                <VBox styleClass="settings-card,card,zone-radius-md">
                    <HBox fx:id="limitsRow" styleClass="settings-row,last" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.speed_limit" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="limit-row" alignment="CENTER_RIGHT" minWidth="-Infinity" maxHeight="-Infinity">
                            <HBox fx:id="downloadLimitBox" styleClass="limit-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT">
                                <Region styleClass="icon-download"/>
                                <TextField fx:id="downloadLimitField" id="downloadLimit" styleClass="limit-input" prefColumnCount="4" HBox.hgrow="ALWAYS"
                                           accessibleText="%settings.limit.download"/>
                                <Label styleClass="limit-unit" text="%settings.unit.kbs" minWidth="-Infinity"/>
                            </HBox>
                            <HBox fx:id="uploadLimitBox" styleClass="limit-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT">
                                <Region styleClass="icon-upload"/>
                                <TextField fx:id="uploadLimitField" id="uploadLimit" styleClass="limit-input" prefColumnCount="4" HBox.hgrow="ALWAYS"
                                           accessibleText="%settings.limit.upload"/>
                                <Label styleClass="limit-unit" text="%settings.unit.kbs" minWidth="-Infinity"/>
                            </HBox>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ЯЗЫК -->
            <VBox fx:id="languageSection" id="settingsLanguage" styleClass="settings-group" maxWidth="Infinity">
                <Label fx:id="languageHeading" styleClass="settings-group-label,font-display" text="%settings.heading.language" minHeight="-Infinity"/>
                <VBox styleClass="settings-card,card,zone-radius-md">
                    <HBox fx:id="languageRow" styleClass="settings-row,last" alignment="CENTER_LEFT">
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="langRu" styleClass="segment,zone-radius-sm" text="Русский" toggleGroup="$languageGroup" minWidth="-Infinity"
                                         accessibleText="%settings.language.interface"/>
                            <RadioButton fx:id="langEn" styleClass="segment,zone-radius-sm" text="English" toggleGroup="$languageGroup" minWidth="-Infinity"
                                         accessibleText="%settings.language.interface"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
            </VBox>

            <!-- JVM, туннель, чувствительность и свап аккаунтов — отдельные страницы на всю область. -->
            <VBox fx:id="clientContent" id="settingsClient" styleClass="settings-page" VBox.vgrow="ALWAYS">
                <VBox fx:id="jvmPage" id="settingsJvm" styleClass="settings-group" maxWidth="Infinity">
                    <Label styleClass="settings-group-label,font-display" text="%settings.heading.jvm" minHeight="-Infinity"/>
                    <Label fx:id="jvmStatus" styleClass="settings-note" minWidth="-Infinity"/>
                    <GridPane fx:id="jvmGrid" styleClass="jvm-grid" hgap="8" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="120"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <VBox fx:id="tunnelPage" id="settingsTunnel" styleClass="settings-group" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                    <Label styleClass="settings-group-label,font-display" text="%settings.heading.tunnel" minHeight="-Infinity"/>
                    <HBox styleClass="tunnel-toolbar" alignment="CENTER_LEFT" maxWidth="Infinity">
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="regionRu" styleClass="segment,zone-radius-sm" text="RU" toggleGroup="$regionGroup" selected="true" minWidth="-Infinity"/>
                            <RadioButton fx:id="regionEu" styleClass="segment,zone-radius-sm" text="EU" toggleGroup="$regionGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="regionNa" styleClass="segment,zone-radius-sm" text="NA" toggleGroup="$regionGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="regionSea" styleClass="segment,zone-radius-sm" text="SEA" toggleGroup="$regionGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="regionNea" styleClass="segment,zone-radius-sm" text="NEA" toggleGroup="$regionGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox styleClass="tunnel-actions" alignment="CENTER_LEFT">
                        <Button fx:id="tunnelMeasure" styleClass="settings-mini" text="%settings.tunnel.measure" mnemonicParsing="false" minWidth="-Infinity"/>
                        <Button fx:id="tunnelFindBest" styleClass="settings-mini,primary" text="%settings.tunnel.find" mnemonicParsing="false" minWidth="-Infinity"/>
                        <VBox fx:id="tunnelMode" styleClass="tunnel-mode" alignment="TOP_LEFT" minWidth="-Infinity" maxHeight="-Infinity"/>
                    </HBox>
                    <ScrollPane fx:id="tunnelScroll" styleClass="tunnel-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                minHeight="120" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                        <VBox fx:id="tunnelPools" styleClass="tunnel-pools"/>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="accountsPage" id="settingsAccounts" styleClass="settings-group" maxWidth="Infinity">
                    <Label styleClass="settings-group-label,font-display" text="%settings.heading.accounts" minHeight="-Infinity"/>
                    <ScrollPane fx:id="sessionScroll" styleClass="session-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                minHeight="96" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                        <VBox fx:id="sessionCards" styleClass="session-cards"/>
                    </ScrollPane>
                    <HBox fx:id="accountsRow" alignment="CENTER_LEFT" spacing="8">
                        <HBox styleClass="settings-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <TextField fx:id="sessionName" promptText="%stalzone.accounts.name" styleClass="limit-input" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Button fx:id="captureSession" styleClass="settings-mini" text="%settings.accounts.save" mnemonicParsing="false" minWidth="-Infinity"/>
                    </HBox>
                </VBox>

                <VBox fx:id="sensPage" id="settingsSens" styleClass="settings-group" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                    <Label styleClass="settings-group-label,font-display" text="%settings.heading.sens" minHeight="-Infinity"/>
                    <VBox styleClass="sens-card,card,zone-radius-md" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                        <HBox fx:id="sensRow" alignment="CENTER_LEFT" spacing="8">
                            <HBox styleClass="settings-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT" minWidth="120" prefWidth="140" maxWidth="180">
                                <TextField fx:id="baseSens" promptText="%stalzone.sens.base" styleClass="limit-input" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Button fx:id="calcSens" styleClass="settings-mini" text="%stalzone.sens.calc" mnemonicParsing="false" minWidth="-Infinity"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                            <Button fx:id="writeSens" styleClass="settings-mini,primary" text="%settings.sens.write" mnemonicParsing="false" minWidth="-Infinity"/>
                        </HBox>
                        <GridPane fx:id="sensChips" styleClass="sens-table" hgap="12" vgap="12" minWidth="0" minHeight="0"
                                  maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
                        <Label fx:id="sensNote" styleClass="settings-note,sens-note" wrapText="true" visible="false" managed="false"/>
                    </VBox>
                </VBox>
                <Label fx:id="clientStatus" styleClass="settings-note" wrapText="true" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
