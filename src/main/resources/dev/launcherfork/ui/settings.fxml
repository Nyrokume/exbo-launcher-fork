<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.RamBar?>
<?import dev.launcherfork.ui.components.RamScale?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Settings page: ONE screen at the minimum window size (Theme.WINDOW_MIN_*, 900x580) in every theme and language, no
  scrolling (SettingsScreenTest). Bound to SettingsStore by SettingsController, every change is saved.

  The page starts BELOW the nav row (main.fxml anchors it under the top bar; no page title: the sidebar already marks
  НАСТРОЙКИ as active). One tidy list: small Bebas group labels, each over a subtle card (.card) whose rows all look
  the same: label left, control right, 32 px, thin separators between rows; no wrapping labels (long wording in
  tooltips).
    ОПЕРАТИВНАЯ ПАМЯТЬ  "Выделено: 6 ГБ из 16 ГБ" + the segmented RAM bar (like the original launcher) + min / max
                        captions under the selectable range (RamScale).
    ПОВЕДЕНИЕ           auto-exit, P2P and the theme (Тёмная / Белая) as segmented controls (accent on the selected
                        part), four switches.
    ОБНОВЛЕНИЕ | ЯЗЫК   one row each, side by side: speed limits (download / upload fields) | Русский / English.
-->
<AnchorPane fx:id="settingsRoot" id="settingsRoot" styleClass="settings-root" stylesheets="@style/layout.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.settings.SettingsController">
    <fx:define>
        <ToggleGroup fx:id="exitGroup"/>
        <ToggleGroup fx:id="p2pGroup"/>
        <ToggleGroup fx:id="languageGroup"/>
        <ToggleGroup fx:id="themeGroup"/>
    </fx:define>
    <ScrollPane fx:id="scroll" id="settingsScroll" styleClass="settings-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox fx:id="settingsContent" id="settingsContent" styleClass="settings-content">
            <!-- ОПЕРАТИВНАЯ ПАМЯТЬ -->
            <VBox fx:id="gameSection" id="settingsGame" styleClass="settings-group">
                <Label fx:id="gameHeading" styleClass="settings-group-label,font-display" text="%settings.heading.ram" minHeight="-Infinity"/>
                <VBox fx:id="ramCard" styleClass="settings-card,card,zone-radius-md,ram-card">
                    <HBox styleClass="ram-head" alignment="CENTER_LEFT">
                        <Label fx:id="ramSummary" id="ramSummary" styleClass="ram-summary" minWidth="-Infinity"/>
                    </HBox>
                    <RamBar fx:id="ramBar" id="ramBar" maxWidth="Infinity" accessibleText="%settings.ram"/>
                    <RamScale fx:id="ramScale" id="ramScale" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- ПОВЕДЕНИЕ -->
            <VBox fx:id="behaviourSection" id="settingsBehaviour" styleClass="settings-group">
                <Label fx:id="behaviourHeading" styleClass="settings-group-label,font-display" text="%settings.heading.behaviour" minHeight="-Infinity"/>
                <VBox fx:id="behaviourCard" styleClass="settings-card,card,zone-radius-md">
                    <HBox fx:id="exitRow" styleClass="settings-row" alignment="CENTER_LEFT">
                        <Label fx:id="exitLabel" styleClass="settings-label,row-label" text="%settings.exit.short" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="exitOnStart" styleClass="segment,zone-radius-sm" text="%settings.exit.game_start" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="exitOnGameExit" styleClass="segment,zone-radius-sm" text="%settings.exit.game_exit" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="exitNever" styleClass="segment,zone-radius-sm" text="%settings.exit.never" toggleGroup="$exitGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="p2pRow" styleClass="settings-row" alignment="CENTER_LEFT">
                        <Label fx:id="p2pLabel" styleClass="settings-label,row-label" text="%settings.p2p.short" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="p2pAlways" styleClass="segment,zone-radius-sm" text="%settings.p2p.always" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="p2pNotMobile" styleClass="segment,zone-radius-sm" text="%settings.p2p.not_mobile" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="p2pNever" styleClass="segment,zone-radius-sm" text="%settings.p2p.never" toggleGroup="$p2pGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="themeRow" styleClass="settings-row" alignment="CENTER_LEFT">
                        <Label fx:id="themeLabel" styleClass="settings-label,row-label" text="%settings.theme" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                            <RadioButton fx:id="themeDark" id="themeDark" styleClass="segment,zone-radius-sm" text="%settings.theme.dark" toggleGroup="$themeGroup" minWidth="-Infinity"/>
                            <RadioButton fx:id="themeLight" id="themeLight" styleClass="segment,zone-radius-sm" text="%settings.theme.light" toggleGroup="$themeGroup" minWidth="-Infinity"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="startOnDownloadedRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.start_on_downloaded" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="startOnDownloadedToggle" styleClass="switch" accessibleText="%settings.start_on_downloaded"/>
                    </HBox>
                    <HBox fx:id="defenderRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.defender" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="defenderToggle" styleClass="switch" accessibleText="%settings.defender"/>
                    </HBox>
                    <HBox fx:id="trayRow" styleClass="settings-row,toggle-row" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.tray" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="trayToggle" styleClass="switch" accessibleText="%settings.tray"/>
                    </HBox>
                    <HBox fx:id="autostartRow" styleClass="settings-row,toggle-row,last" alignment="CENTER_LEFT">
                        <Label styleClass="settings-label,row-label" text="%settings.run_on_start" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                        <CheckBox fx:id="autostartToggle" styleClass="switch" accessibleText="%settings.run_on_start"/>
                    </HBox>
                </VBox>
            </VBox>

            <HBox fx:id="columns" styleClass="settings-columns">
                <!-- ОБНОВЛЕНИЕ -->
                <VBox fx:id="updatesSection" id="settingsUpdates" styleClass="settings-group" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="updatesHeading" styleClass="settings-group-label,font-display" text="%settings.heading.updates" minHeight="-Infinity"/>
                    <VBox styleClass="settings-card,card,zone-radius-md">
                        <HBox fx:id="limitsRow" styleClass="settings-row,last" alignment="CENTER_LEFT">
                            <Label styleClass="settings-label,row-label" text="%settings.speed_limit" minWidth="-Infinity"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="16"/>
                            <HBox styleClass="limit-row" alignment="CENTER_RIGHT" minWidth="-Infinity" maxHeight="-Infinity">
                                <HBox fx:id="downloadLimitBox" styleClass="limit-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT">
                                    <Region styleClass="icon-download"/>
                                    <TextField fx:id="downloadLimitField" id="downloadLimit" styleClass="limit-input" prefColumnCount="4" HBox.hgrow="ALWAYS"
                                               accessibleText="%settings.limit.download"/>
                                    <Label styleClass="limit-unit" text="%settings.unit.kbs" minWidth="-Infinity"/>
                                </HBox>
                                <HBox fx:id="uploadLimitBox" styleClass="limit-field,zone-input,zone-radius-sm" alignment="CENTER_LEFT">
                                    <Region styleClass="icon-upload"/>
                                    <TextField fx:id="uploadLimitField" id="uploadLimit" styleClass="limit-input" prefColumnCount="4" HBox.hgrow="ALWAYS"
                                               accessibleText="%settings.limit.upload"/>
                                    <Label styleClass="limit-unit" text="%settings.unit.kbs" minWidth="-Infinity"/>
                                </HBox>
                            </HBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ЯЗЫК -->
                <VBox fx:id="languageSection" id="settingsLanguage" styleClass="settings-group" minWidth="-Infinity">
                    <Label fx:id="languageHeading" styleClass="settings-group-label,font-display" text="%settings.heading.language" minHeight="-Infinity"/>
                    <VBox styleClass="settings-card,card,zone-radius-md">
                        <HBox fx:id="languageRow" styleClass="settings-row,last" alignment="CENTER_LEFT">
                            <HBox styleClass="segmented,zone-radius-sm" alignment="CENTER" minWidth="-Infinity" maxHeight="-Infinity">
                                <RadioButton fx:id="langRu" styleClass="segment,zone-radius-sm" text="Русский" toggleGroup="$languageGroup" minWidth="-Infinity"
                                             accessibleText="%settings.language.interface"/>
                                <RadioButton fx:id="langEn" styleClass="segment,zone-radius-sm" text="English" toggleGroup="$languageGroup" minWidth="-Infinity"
                                             accessibleText="%settings.language.interface"/>
                            </HBox>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
