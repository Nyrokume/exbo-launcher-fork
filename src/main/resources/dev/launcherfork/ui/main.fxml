<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Main screen (adaptive): fixed-width sidebar on the left, the content area stretches with the window.
  Every area has its own FXML + controller (fx:include). Modal layers cover the whole screen.
  Explicit ids are set on nodes whose fx:id matches a legacy CSS #id rule.
-->
<StackPane fx:id="root" id="mainRoot" styleClass="main-window" stylesheets="@style/layout.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dev.launcherfork.ui.screens.main.MainController">
    <BorderPane fx:id="layout">
        <left>
            <fx:include fx:id="serversList" source="main/servers_list.fxml"/>
        </left>
        <center>
            <StackPane fx:id="main" id="mainContent" styleClass="main-content">
                <!-- game art (from data), desaturated; the shade adds the left/bottom fade -->
                <Region fx:id="background" id="gameArt" styleClass="game-art" mouseTransparent="true"/>
                <Region fx:id="backgroundShade" styleClass="game-art-shade" mouseTransparent="true"/>

                <AnchorPane fx:id="homePane" pickOnBounds="false">
                    <fx:include fx:id="hero" source="main/hero.fxml"
                                AnchorPane.leftAnchor="15" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="250"/>
                    <fx:include fx:id="header" source="main/header.fxml"
                                AnchorPane.rightAnchor="19" AnchorPane.topAnchor="48"/>
                    <fx:include fx:id="advancedNewsPane" source="main/news.fxml"
                                AnchorPane.rightAnchor="8" AnchorPane.topAnchor="157" AnchorPane.bottomAnchor="82"/>
                    <fx:include fx:id="articleBg" source="main/article.fxml"
                                AnchorPane.leftAnchor="15" AnchorPane.topAnchor="200" AnchorPane.rightAnchor="330" AnchorPane.bottomAnchor="82"/>
                    <fx:include fx:id="defaultStatusPane" source="main/status_pane.fxml"
                                AnchorPane.leftAnchor="11" AnchorPane.rightAnchor="21" AnchorPane.bottomAnchor="20"/>
                    <fx:include fx:id="clientSettingsPane" source="main/client_settings.fxml"
                                AnchorPane.rightAnchor="190" AnchorPane.bottomAnchor="52"/>
                </AnchorPane>

                <AnchorPane fx:id="settingsPane" visible="false">
                    <fx:include fx:id="settings" source="settings.fxml"
                                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
                </AnchorPane>
            </StackPane>
        </center>
    </BorderPane>

    <!-- modal layers (hidden by default), one FXML + controller each -->
    <fx:include fx:id="logoutPane" source="main/modals/logout_pane.fxml"/>
    <fx:include fx:id="updatePane" source="main/modals/update_pane.fxml"/>
    <fx:include fx:id="licensePane" source="main/modals/license_pane.fxml"/>
    <fx:include fx:id="offlinePane" source="main/modals/offline_pane.fxml"/>
    <fx:include fx:id="downloadWarnPane" source="main/modals/download_warn_pane.fxml"/>
    <fx:include fx:id="defenderPane" source="main/modals/defender_pane.fxml"/>
    <fx:include fx:id="exceptionPane" source="main/modals/exception_pane.fxml"/>
    <fx:include fx:id="loadingPane" source="main/modals/loading_pane.fxml"/>
    <fx:include fx:id="deletionPane" source="main/modals/deletion_pane.fxml"/>
    <fx:include fx:id="installPane" source="main/modals/install_pane.fxml"/>
</StackPane>
