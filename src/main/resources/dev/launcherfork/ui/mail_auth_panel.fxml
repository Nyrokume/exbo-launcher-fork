<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.CodeInput?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  E-mail 2FA panel — same layout contract as totp_auth_panel.fxml:
  content-sized (compact window, user 2026-10-27): the top card keeps its padding only, the window grows when
  the error toast shows; bottom form is dense (label → cells → toast → ПОДТВЕРДИТЬ → footer).
  No growing spacer between cells and CTA (avoids empty mid-form zones).
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css,@style/zone-steps.css,@style/zone-totp.css" minWidth="420.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.auth.MailAuthController">
    <VBox styleClass="zone-frame">
        <HBox styleClass="zone-titlebar" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" mnemonicParsing="false" />
        </HBox>

        <VBox styleClass="zone-top, zone-top-compact" alignment="CENTER_LEFT">
            <Label styleClass="zone-title" text="%fork.zone.mail_title" wrapText="true" minHeight="-Infinity" />
            <Label styleClass="zone-description" text="%fork.zone.mail_info" wrapText="true" minHeight="-Infinity" />
        </VBox>

        <VBox styleClass="zone-bottom, zone-bottom-dense">
            <Label styleClass="zone-field-label" text="%auth.mail_code" />
            <CodeInput fx:id="codeInput" id="zoneMailCode" cellCount="9" alignment="CENTER" />
            <HBox fx:id="toast" id="zoneMailToast" styleClass="zone-toast, zone-radius-md" visible="false" managed="false" maxHeight="-Infinity" maxWidth="Infinity">
                <VBox styleClass="zone-toast-body" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <Label styleClass="zone-toast-title" text="%fork.2fa.error_title" wrapText="true" minHeight="-Infinity" />
                    <Label id="zoneErrorFirst" fx:id="errorFirst" styleClass="zone-toast-text" wrapText="true" minHeight="-Infinity" />
                    <Label id="zoneErrorSecond" fx:id="errorSecond" styleClass="zone-toast-text" wrapText="true" minHeight="-Infinity" />
                </VBox>
                <Button fx:id="toastClose" id="zoneMailToastClose" styleClass="zone-toast-close" mnemonicParsing="false" onAction="#onCloseToast">
                    <graphic><Region styleClass="zone-toast-x" /></graphic>
                </Button>
            </HBox>
            <Button id="zoneConfirm" fx:id="enterButton" styleClass="zone-primary, zone-radius-sm" mnemonicParsing="false" onAction="#enter" text="%fork.zone.confirm" maxWidth="Infinity" />
            <HBox styleClass="zone-footer">
                <Label styleClass="zone-footer-text" text="%fork.zone.wrong_account" />
                <Button id="zoneBack" fx:id="backButton" styleClass="zone-link-underline" mnemonicParsing="false" onAction="#onBack" text="%fork.zone.back" />
            </HBox>
        </VBox>
    </VBox>
    <ProgressIndicator fx:id="rollingBar" styleClass="zone-spinner" visible="false" />
</StackPane>
