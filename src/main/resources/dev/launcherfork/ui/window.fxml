<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Frame of the ONE launcher window (undecorated, resizable): title bar + content host + overlay layer.
  main.fxml is put into contentHost; update/auth panels go into overlayLayer (docs/design/OVERLAY.md).
  Explicit ids (window*) keep legacy #close/#hide rules of common.css away from these buttons.
-->
<StackPane fx:id="windowRoot" id="appWindow" styleClass="app-window" stylesheets="@style/layout.css"
           prefWidth="1024" prefHeight="640"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dev.launcherfork.ui.screens.window.WindowController">
    <BorderPane>
        <top>
            <HBox fx:id="titleBar" id="titleBar" styleClass="title-bar" alignment="CENTER_RIGHT">
                <Region fx:id="dragArea" id="titleDragArea" styleClass="title-drag-area" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity"/>
                <Button fx:id="hideButton" id="windowHide" styleClass="window-button,window-hide" focusTraversable="false" mnemonicParsing="false">
                    <graphic><Region styleClass="window-glyph"/></graphic>
                </Button>
                <Button fx:id="maximizeButton" id="windowMaximize" styleClass="window-button,window-maximize" focusTraversable="false" mnemonicParsing="false">
                    <graphic><Region styleClass="window-glyph"/></graphic>
                </Button>
                <Button fx:id="closeButton" id="windowClose" styleClass="window-button,window-close" focusTraversable="false" mnemonicParsing="false">
                    <graphic><Region styleClass="window-glyph"/></graphic>
                </Button>
            </HBox>
        </top>
        <center>
            <StackPane id="windowCenter">
                <StackPane fx:id="contentHost" id="contentHost" styleClass="content-host"/>
                <StackPane fx:id="overlayLayer" id="overlayLayer" styleClass="overlay-layer" visible="false"/>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
