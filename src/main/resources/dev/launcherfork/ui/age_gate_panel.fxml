<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  Registration step 1: age gate, after the stalzone.com/register age check ("HOW OLD ARE YOU?"), localized.
  Top block: title + "enter your date of birth"; bottom block: day / month / year dropdowns, ПРОДОЛЖИТЬ (grey until
  all three are chosen; too young -> error under the dropdowns), red support link, back to login.
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css,@style/zone-steps.css" minWidth="420.0" prefWidth="460.0" minHeight="560.0" prefHeight="588.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.auth.AgeGateController">
    <VBox styleClass="zone-frame">
        <HBox styleClass="zone-titlebar" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" mnemonicParsing="false" />
        </HBox>

        <VBox styleClass="zone-top">
            <Label styleClass="zone-title" text="%fork.age.title" wrapText="true" minHeight="-Infinity" />
            <Label styleClass="zone-description" text="%fork.age.info" wrapText="true" minHeight="-Infinity" />
        </VBox>

        <VBox styleClass="zone-bottom" VBox.vgrow="ALWAYS">
            <ComboBox fx:id="dayBox" id="zoneDay" styleClass="zone-combo, zone-radius-sm" promptText="%fork.age.day" maxWidth="Infinity" visibleRowCount="8" />
            <ComboBox fx:id="monthBox" id="zoneMonth" styleClass="zone-combo, zone-radius-sm" promptText="%fork.age.month" maxWidth="Infinity" visibleRowCount="8" />
            <ComboBox fx:id="yearBox" id="zoneYear" styleClass="zone-combo, zone-radius-sm" promptText="%fork.age.year" maxWidth="Infinity" visibleRowCount="8" />
            <VBox styleClass="zone-errors">
                <Label id="zoneErrorFirst" fx:id="errorFirst" styleClass="zone-error" wrapText="true" />
                <Label id="zoneErrorSecond" fx:id="errorSecond" styleClass="zone-notice-text" wrapText="true" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" styleClass="zone-spacer" />
            <Button id="zoneAgeContinue" fx:id="continueButton" styleClass="zone-primary, zone-radius-sm" mnemonicParsing="false" onAction="#onContinue" text="%fork.age.continue" maxWidth="Infinity" />
            <HBox styleClass="zone-center-row">
                <Button id="zoneSupport" fx:id="supportLink" styleClass="zone-link-accent, zone-link-plain" mnemonicParsing="false" onAction="#onSupport" text="%fork.age.support" />
            </HBox>
            <HBox styleClass="zone-footer">
                <Label styleClass="zone-footer-text" text="%fork.reg.have_account" />
                <Button id="zoneBack" fx:id="backButton" styleClass="zone-link-underline" mnemonicParsing="false" onAction="#onBack" text="%fork.reg.sign_in" />
            </HBox>
        </VBox>
    </VBox>
    <ProgressIndicator fx:id="rollingBar" styleClass="zone-spinner" visible="false" />
</StackPane>
