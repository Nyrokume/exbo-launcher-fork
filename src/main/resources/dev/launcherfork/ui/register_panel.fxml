<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Registration step 2, after stalzone.com/register: header strip "СОЗДАТЬ АККАУНТ В STALZONE" (card, a shade lighter),
  e-mail, username, password with the eye toggle, newsletter checkbox (optional), license checkbox with underlined
  links (required). СОЗДАТЬ АККАУНТ is grey until e-mail, username and password are filled and the license box is
  ticked; format errors use the compact toast (same as TOTP) and paint the field. Footer: back to the age gate, sign in.
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css,@style/zone-steps.css" minWidth="420.0" prefWidth="460.0" minHeight="560.0" prefHeight="668.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.auth.RegisterController">
    <VBox styleClass="zone-frame">
        <HBox styleClass="zone-titlebar" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" mnemonicParsing="false" />
        </HBox>

        <VBox styleClass="zone-top, zone-top-compact">
            <Label styleClass="zone-title" text="%fork.reg.title" wrapText="true" minHeight="-Infinity" />
        </VBox>

        <VBox styleClass="zone-bottom, zone-bottom-dense, zone-reg-form" VBox.vgrow="ALWAYS">
            <TextField id="zoneRegEmail" fx:id="emailField" styleClass="zone-input, zone-radius-sm" onAction="#onCreate" promptText="%fork.reg.email" />
            <TextField id="zoneRegUsername" fx:id="usernameField" styleClass="zone-input, zone-radius-sm" onAction="#onCreate" promptText="%fork.reg.username" />
            <StackPane styleClass="zone-password">
                <PasswordField id="zoneRegPassword" fx:id="passwordField" styleClass="zone-input, zone-radius-sm" onAction="#onCreate" promptText="%auth.password" />
                <TextField id="zoneRegPasswordPlain" fx:id="passwordVisibleField" styleClass="zone-input, zone-radius-sm" onAction="#onCreate" promptText="%auth.password" visible="false" />
                <ToggleButton id="zoneRegEye" fx:id="passwordToggle" styleClass="zone-eye" mnemonicParsing="false" StackPane.alignment="CENTER_RIGHT">
                    <graphic><Region styleClass="zone-icon, icon-eye" /></graphic>
                </ToggleButton>
            </StackPane>
            <HBox styleClass="zone-check-row">
                <CheckBox id="zoneNewsletter" fx:id="newsletterCheckBox" styleClass="zone-check, zone-radius-sm" mnemonicParsing="false" />
                <TextFlow fx:id="newsletterText" styleClass="zone-check-flow" HBox.hgrow="ALWAYS">
                    <Text styleClass="zone-check-text" text="%fork.reg.newsletter" />
                </TextFlow>
            </HBox>
            <HBox styleClass="zone-check-row">
                <CheckBox id="zoneLicense" fx:id="licenseCheckBox" styleClass="zone-check, zone-radius-sm" mnemonicParsing="false" />
                <TextFlow fx:id="licenseText" styleClass="zone-check-flow" HBox.hgrow="ALWAYS">
                    <Text styleClass="zone-check-text" text="%fork.reg.license_1" />
                    <Hyperlink id="zoneLicenseLink" fx:id="licenseLink" styleClass="zone-inline-link" text="%fork.reg.license_link" onAction="#onDocLink" />
                    <Text styleClass="zone-check-text" text="%fork.reg.license_2" />
                    <Hyperlink id="zonePrivacyLink" fx:id="privacyLink" styleClass="zone-inline-link" text="%fork.reg.privacy_link" onAction="#onDocLink" />
                    <Text styleClass="zone-check-text" text="." />
                </TextFlow>
            </HBox>
            <HBox fx:id="toast" id="zoneRegToast" styleClass="zone-toast, zone-radius-md" visible="false" managed="false" maxHeight="-Infinity" maxWidth="Infinity">
                <VBox styleClass="zone-toast-body" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <Label styleClass="zone-toast-title" text="%fork.reg.error_title" wrapText="true" minHeight="-Infinity" />
                    <Label id="zoneErrorFirst" fx:id="errorFirst" styleClass="zone-toast-text" wrapText="true" minHeight="-Infinity" />
                    <Label id="zoneErrorSecond" fx:id="errorSecond" styleClass="zone-toast-text" wrapText="true" minHeight="-Infinity" />
                </VBox>
                <Button fx:id="toastClose" id="zoneRegToastClose" styleClass="zone-toast-close" mnemonicParsing="false" onAction="#onCloseToast">
                    <graphic><Region styleClass="zone-toast-x" /></graphic>
                </Button>
            </HBox>
            <Region VBox.vgrow="ALWAYS" styleClass="zone-spacer" />
            <Button id="zoneRegCreate" fx:id="createButton" styleClass="zone-primary, zone-radius-sm" mnemonicParsing="false" onAction="#onCreate" text="%fork.reg.create" maxWidth="Infinity" />
            <BorderPane styleClass="zone-footer-split">
                <left>
                    <Button id="zoneRegBack" fx:id="backButton" styleClass="zone-link-accent" mnemonicParsing="false" onAction="#onBack" text="%fork.reg.back" BorderPane.alignment="CENTER_LEFT" />
                </left>
                <right>
                    <HBox styleClass="zone-footer" BorderPane.alignment="CENTER_RIGHT">
                        <Label styleClass="zone-footer-text" text="%fork.reg.have_account" />
                        <Button id="zoneRegSignIn" fx:id="loginLink" styleClass="zone-link-underline" mnemonicParsing="false" onAction="#onLogin" text="%fork.reg.sign_in" />
                    </HBox>
                </right>
            </BorderPane>
        </VBox>
    </VBox>
    <ProgressIndicator fx:id="rollingBar" styleClass="zone-spinner" visible="false" />
</StackPane>
