<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Text?>

<!-- One server card in the sidebar (original server_entry.fxml; colors/fonts moved from code to CSS). -->
<AnchorPane id="background" fx:id="root" maxHeight="47.0" minHeight="47" prefHeight="47.0" prefWidth="222.0" styleClass="server-entry"
            stylesheets="@style/common.css,@style/main.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.components.ServerEntryController">
   <children>
      <Pane fx:id="image" cache="true" layoutX="7.0" layoutY="4.0" maxHeight="40.0" maxWidth="40.0" prefHeight="40.0" prefWidth="40.0" />
      <Text fx:id="status" layoutX="62.0" layoutY="38.0" text="online" />
      <Text fx:id="name" layoutX="62.0" layoutY="24.0" text="Server name" styleClass="font-display" />
      <ProgressBar id="progress" fx:id="progress" maxHeight="1" minHeight="1" prefHeight="1" progress="0.0" visible="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="1" AnchorPane.rightAnchor="0" />
      <Region fx:id="icon" layoutX="186.0" layoutY="14.0" maxHeight="33" prefHeight="22.0" prefWidth="22.0" />
      <Text fx:id="downloadingStatus" layoutX="185.0" layoutY="26.0" text="99%" styleClass="font-display" />
      <ImageView fx:id="cursor" fitHeight="47.0" fitWidth="3.0" pickOnBounds="true" preserveRatio="true" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="0.0">
         <Image url="@style/image/server_cursor.png" />
      </ImageView>
   </children>
</AnchorPane>
