<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  Zone-style login panel for the main window's overlay slot (reference 3: EXBO / STALCRAFT X).
  Self-contained: own stylesheet, flow layout (no layoutX/Y), same fx:ids and controller as initial_auth.fxml,
  so navigation and tests keep working. The host centers it in overlayLayer and blurs the content below.
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css" minWidth="502.0" prefWidth="502.0" maxWidth="502.0" minHeight="540.0" prefHeight="540.0" maxHeight="540.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.auth.InitialAuthController">
    <VBox styleClass="zone-frame, zone-radius-md">
        <!-- the single window has its own title bar (OVERLAY.md); kept for the controller fx:ids, hidden -->
        <HBox styleClass="zone-titlebar" alignment="CENTER_RIGHT" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" styleClass="zone-window-button, zone-hide" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" styleClass="zone-window-button, zone-close" mnemonicParsing="false" />
        </HBox>
        <VBox styleClass="zone-body" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
            <Label styleClass="zone-logo" text="%fork.zone.logo" />
            <Label styleClass="zone-logo-sub" text="%fork.zone.logo_sub" />
            <VBox styleClass="zone-errors" alignment="CENTER">
                <Label fx:id="errorFirst" styleClass="zone-error" />
                <Label fx:id="errorSecond" styleClass="zone-error" />
            </VBox>
            <TextField fx:id="loginField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%auth.login" />
            <StackPane styleClass="zone-password">
                <PasswordField fx:id="passwordField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%auth.password" />
                <TextField fx:id="passwordVisibleField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%auth.password" visible="false" />
                <ToggleButton fx:id="passwordToggle" styleClass="zone-eye" mnemonicParsing="false" focusTraversable="false" StackPane.alignment="CENTER_RIGHT">
                    <graphic><Region styleClass="zone-icon, icon-eye" /></graphic>
                </ToggleButton>
            </StackPane>
            <HBox styleClass="zone-remember" alignment="CENTER">
                <CheckBox fx:id="autoAuthCheckBox" styleClass="zone-check" mnemonicParsing="false" onAction="#onAutoAuth" />
                <Label styleClass="zone-check-label" onMouseClicked="#onLabelAutoAuth" text="%auth.auto_auth" />
            </HBox>
            <!-- explicit id: otherwise fx:id becomes the id and lang_*.css #enterButton paints the old PNG -->
            <Button id="zoneEnter" fx:id="enterButton" styleClass="zone-primary, zone-radius-sm" mnemonicParsing="false" onAction="#onEnter" text="%fork.zone.enter" />
            <VBox styleClass="zone-links" alignment="CENTER">
                <Button fx:id="enterSteamButton" styleClass="zone-link" mnemonicParsing="false" onAction="#onEnterSteam" text="%fork.auth.steam">
                    <graphic><Region styleClass="zone-icon, icon-steam" /></graphic>
                </Button>
                <Button fx:id="restoreButton" styleClass="zone-link" mnemonicParsing="false" onMouseClicked="#onRestore" text="%fork.zone.restore">
                    <graphic><Region styleClass="zone-icon, icon-key" /></graphic>
                </Button>
                <Button fx:id="registerButton" styleClass="zone-link" mnemonicParsing="false" onMouseClicked="#onRegister" text="%fork.auth.register">
                    <graphic><Region styleClass="zone-icon, icon-user-plus" /></graphic>
                </Button>
            </VBox>
        </VBox>
        <Region styleClass="zone-glow" />
    </VBox>
    <ProgressIndicator fx:id="rollingBar" styleClass="zone-spinner" visible="false" />
</StackPane>
