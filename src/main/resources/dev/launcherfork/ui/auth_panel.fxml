<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.Boolean?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  Login panel for the separate login window, after stalzone.com/login (docs: /workspace/stalzone/site-ref/LOGIN.md).
  Top block (card): title, social tiles (Steam, Epic Games; no Google: not supported by the auth backend). Bottom block (card description): fields, remember / restore, ВОЙТИ, sign up.
  Self-contained: own stylesheet, flow layout, same fx:ids and controller as initial_auth.fxml.
  The panel fills the window (pref 460x588 under a 32 px title bar), so the blocks have no rounded corners of their own.
  Explicit ids where the fx:id matches a legacy CSS id (lang_*.css / auth.css paint old PNGs on those).
-->
<StackPane fx:id="root" styleClass="zone-panel" stylesheets="@style/zone-auth.css" minWidth="420.0" prefWidth="460.0" minHeight="560.0" prefHeight="588.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.launcherfork.ui.screens.auth.InitialAuthController">
    <fx:define>
        <!-- hover states come from zone-auth.css, so the controller skips the legacy brightness effect -->
        <Boolean fx:id="cssHover" fx:value="true" />
    </fx:define>
    <VBox styleClass="zone-frame">
        <!-- the window has its own title bar; kept for the controller fx:ids, hidden -->
        <HBox styleClass="zone-titlebar" visible="false" managed="false">
            <ImageView fx:id="header" managed="false" visible="false" />
            <Button fx:id="hideButton" visible="false" mnemonicParsing="false" />
            <Button fx:id="closeButton" visible="false" mnemonicParsing="false" />
        </HBox>

        <VBox styleClass="zone-top" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label styleClass="zone-title" text="%fork.zone.title" wrapText="true" minHeight="-Infinity" />
            <Label styleClass="zone-description" text="%fork.zone.social" wrapText="true" minHeight="-Infinity" />
            <HBox styleClass="zone-socials">
                <Button id="zoneSteam" fx:id="enterSteamButton" styleClass="zone-social, zone-radius-sm" mnemonicParsing="false" onAction="#onEnterSteam" accessibleText="Steam">
                    <graphic><Region styleClass="zone-social-icon, icon-steam" /></graphic>
                </Button>
                <Button id="zoneEpic" styleClass="zone-social, zone-radius-sm" mnemonicParsing="false" onAction="#onEnterEpic" accessibleText="Epic Games">
                    <graphic><Region styleClass="zone-social-icon, icon-epic" /></graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox styleClass="zone-bottom">
            <TextField id="zoneLogin" fx:id="loginField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%fork.zone.login_prompt" />
            <StackPane styleClass="zone-password">
                <PasswordField id="zonePassword" fx:id="passwordField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%auth.password" />
                <TextField id="zonePasswordPlain" fx:id="passwordVisibleField" styleClass="zone-input, zone-radius-sm" onAction="#onEnter" promptText="%auth.password" visible="false" />
                <ToggleButton id="zoneEye" fx:id="passwordToggle" styleClass="zone-eye" mnemonicParsing="false" StackPane.alignment="CENTER_RIGHT">
                    <graphic><Region styleClass="zone-icon, icon-eye" /></graphic>
                </ToggleButton>
            </StackPane>
            <VBox styleClass="zone-errors">
                <Label id="zoneErrorFirst" fx:id="errorFirst" styleClass="zone-error" wrapText="true" />
                <Label id="zoneErrorSecond" fx:id="errorSecond" styleClass="zone-error" wrapText="true" />
            </VBox>
            <BorderPane styleClass="zone-row">
                <left>
                    <CheckBox id="zoneRemember" fx:id="autoAuthCheckBox" styleClass="zone-check, zone-radius-sm" mnemonicParsing="false" onAction="#onAutoAuth" text="%fork.zone.remember" BorderPane.alignment="CENTER_LEFT" />
                </left>
                <right>
                    <Button id="zoneRestore" fx:id="restoreButton" styleClass="zone-link-accent" mnemonicParsing="false" onAction="#onRestore" text="%fork.zone.restore" BorderPane.alignment="CENTER_RIGHT" />
                </right>
            </BorderPane>
            <Region styleClass="zone-spacer" />
            <Button id="zoneEnter" fx:id="enterButton" styleClass="zone-primary, zone-radius-sm" mnemonicParsing="false" onAction="#onEnter" text="%fork.zone.enter" maxWidth="Infinity" />
            <HBox styleClass="zone-footer">
                <Label styleClass="zone-footer-text" text="%fork.zone.no_account" />
                <Button id="zoneRegister" fx:id="registerButton" styleClass="zone-link-underline" mnemonicParsing="false" onAction="#onRegister" text="%fork.zone.create" />
            </HBox>
        </VBox>
    </VBox>
    <ProgressIndicator fx:id="rollingBar" styleClass="zone-spinner" visible="false" />
</StackPane>
