<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- "Advanced news" block of the main window: 4 news cards + social links. Content comes from NewsRepository. -->
<AnchorPane fx:id="advancedNewsPane" prefHeight="355.0" prefWidth="646.0" pickOnBounds="false"
            stylesheets="@../style/common.css,@../style/main.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.NewsController">
    <AnchorPane fx:id="thirdNewsPane" maxHeight="100" maxWidth="180" minHeight="100" minWidth="180" prefHeight="100" prefWidth="180" styleClass="news-card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="210.0" AnchorPane.topAnchor="255.0">
        <ImageView fx:id="thirdNewsBg" fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <ImageView fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../style/image/news_big_border.png"/>
        </ImageView>
        <ImageView fitHeight="10.0" fitWidth="10.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <Image url="@../style/image/news_external_link.png"/>
        </ImageView>
    </AnchorPane>
    <Pane fx:id="discord" prefHeight="24.0" prefWidth="24.0" styleClass="social-link" AnchorPane.rightAnchor="82.0" AnchorPane.topAnchor="30.0"/>
    <Pane fx:id="youtube" prefHeight="24.0" prefWidth="24.0" styleClass="social-link" AnchorPane.rightAnchor="46.0" AnchorPane.topAnchor="30.0"/>
    <Pane fx:id="twitch" prefHeight="24.0" prefWidth="24.0" styleClass="social-link" AnchorPane.rightAnchor="118.0" AnchorPane.topAnchor="30.0"/>
    <Pane fx:id="instagram" prefHeight="24.0" prefWidth="24.0" styleClass="social-link" AnchorPane.rightAnchor="154.0" AnchorPane.topAnchor="30.0"/>
    <Pane fx:id="vk" prefHeight="24.0" prefWidth="24.0" styleClass="social-link" AnchorPane.rightAnchor="190.0" AnchorPane.topAnchor="30.0"/>
    <ImageView fx:id="bigLogo" fitHeight="30.0" fitWidth="144.0" pickOnBounds="true" preserveRatio="true" AnchorPane.topAnchor="25.0">
        <Image url="@../style/image/logo.png"/>
    </ImageView>
    <AnchorPane fx:id="fourthNewsPane" maxHeight="100" maxWidth="180" minHeight="100" minWidth="180" prefHeight="100" prefWidth="180" styleClass="news-card" AnchorPane.leftAnchor="420.0" AnchorPane.topAnchor="255.0">
        <ImageView fx:id="fourthNewsBg" fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <ImageView fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../style/image/news_big_border.png"/>
        </ImageView>
        <ImageView fitHeight="10.0" fitWidth="10.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <Image url="@../style/image/news_external_link.png"/>
        </ImageView>
    </AnchorPane>
    <Label id="advancedNewsTitle" fx:id="mainLink" text="%jfx.launcher.main.news" styleClass="font-display" AnchorPane.leftAnchor="154.0" AnchorPane.topAnchor="33.0"/>
    <ImageView fitHeight="10.0" fitWidth="10.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="240.0" AnchorPane.topAnchor="45.0">
        <Image url="@../style/image/news_external_link.png"/>
    </ImageView>
    <AnchorPane fx:id="secondNewsPane" maxHeight="100" maxWidth="180" minHeight="100" minWidth="180" prefHeight="100" prefWidth="180" styleClass="news-card" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="255.0">
        <ImageView fx:id="secondNewsBg" fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <ImageView fitHeight="100" fitWidth="180" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../style/image/news_big_border.png"/>
        </ImageView>
        <ImageView fitHeight="10.0" fitWidth="10.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <Image url="@../style/image/news_external_link.png"/>
        </ImageView>
    </AnchorPane>
    <AnchorPane fx:id="firstNewsPane" maxHeight="148" maxWidth="260" minHeight="148" minWidth="260" prefHeight="148" prefWidth="260" styleClass="news-card" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="85.0">
        <ImageView fx:id="firstNewsBg" fitHeight="148" fitWidth="260" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <ImageView fitHeight="148" fitWidth="260" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../style/image/news_big_border.png"/>
        </ImageView>
        <ImageView fitHeight="10.0" fitWidth="10.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <Image url="@../style/image/news_external_link.png"/>
        </ImageView>
    </AnchorPane>
    <VBox fx:id="firstNewsDescPane" spacing="6" maxWidth="300.0" prefWidth="300.0" AnchorPane.leftAnchor="290.0" AnchorPane.topAnchor="90.0"/>
    <TextFlow fx:id="secondNewsDesc" maxWidth="180.0" prefHeight="40.0" prefWidth="180.0" AnchorPane.leftAnchor="0.0" AnchorPane.bottomAnchor="5.0"/>
    <TextFlow fx:id="thirdNewsDesc" maxHeight="40.0" maxWidth="180.0" prefHeight="40.0" prefWidth="180.0" AnchorPane.leftAnchor="210.0" AnchorPane.bottomAnchor="5.0"/>
    <TextFlow fx:id="fourthNewsDesc" maxHeight="40.0" prefHeight="40.0" prefWidth="180.0" AnchorPane.leftAnchor="420.0" AnchorPane.bottomAnchor="5.0"/>
</AnchorPane>
