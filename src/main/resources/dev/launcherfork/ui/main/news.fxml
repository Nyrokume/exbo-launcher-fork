<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- News column: heading + scrollable cards from NewsRepository + thin red scroll indicator. -->
<VBox fx:id="advancedNewsPane" id="news" styleClass="news" alignment="TOP_RIGHT" spacing="14" pickOnBounds="false"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.NewsController">
    <Label fx:id="mainLink" id="newsHeading" text="%main.news.title" styleClass="news-heading,font-display" minHeight="-Infinity"/>
    <HBox spacing="9" VBox.vgrow="ALWAYS" maxHeight="Infinity">
        <ScrollPane fx:id="newsScroll" id="newsScroll" styleClass="news-scroll" hbarPolicy="NEVER" vbarPolicy="NEVER"
                    fitToWidth="true" minWidth="295" prefWidth="295" maxWidth="295" maxHeight="Infinity">
            <VBox fx:id="newsList" id="newsList" spacing="18"/>
        </ScrollPane>
        <Pane fx:id="scrollTrack" id="newsScrollTrack" styleClass="news-scroll-track" minWidth="4" prefWidth="4" maxWidth="4" maxHeight="Infinity">
            <Region fx:id="scrollThumb" id="newsScrollThumb" styleClass="news-scroll-thumb" prefWidth="4"/>
        </Pane>
    </HBox>
</VBox>
