<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- A news item opened inside the window (translucent dark panel). -->
<VBox fx:id="articleBg" id="article" styleClass="article-panel,card,zone-radius-md" visible="false" spacing="10"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.ArticleController">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="articleCaption" id="articleCaption" styleClass="article-caption,font-display" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="articleCloseButton" id="articleClose" styleClass="article-close,tile,zone-radius-sm" mnemonicParsing="false" focusTraversable="false">
            <graphic><Region styleClass="close-glyph"/></graphic>
        </Button>
    </HBox>
    <Region fx:id="articleCaptionUnderline" styleClass="heading-rule"/>
    <ScrollPane fx:id="articleScroll" styleClass="article-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox fx:id="articleContent" spacing="12"/>
    </ScrollPane>
</VBox>
