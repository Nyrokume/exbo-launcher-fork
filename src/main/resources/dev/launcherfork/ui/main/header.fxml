<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Header links in one row, left of the profile control in main.fxml's top bar: СООБЩЕСТВА ▾ (dropdown with the
     STALZONE social links), ФОРУМ ↗, ПОДДЕРЖКА ↗ (no browser in the fork for those two: "not available").
     Profile ↗ moved into the profile dropdown (main/profile.fxml).
     The communities card (communityMenu) is always managed="false": it floats under СООБЩЕСТВА
     (HeaderController.placeMenu) and never takes part in the row's layout, like the profile dropdown.
     Its rows are built from CommunityLinks by the controller. -->
<HBox fx:id="headerPane" id="headerLinks" styleClass="header-links" alignment="CENTER_RIGHT" pickOnBounds="false"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.HeaderController">
    <HBox fx:id="linksContainer" styleClass="header-links-row" alignment="CENTER_RIGHT">
        <Button fx:id="communities" id="linkCommunities" styleClass="header-link,header-menu-toggle,menu-item,zone-caps"
                text="%main.link.communities" contentDisplay="RIGHT" mnemonicParsing="false"
                accessibleText="%main.community.a11y" accessibleHelp="%main.community.a11y.help">
            <graphic><Region fx:id="communitiesCaret" styleClass="header-caret"/></graphic>
        </Button>
        <Label fx:id="forum" id="linkForum" styleClass="header-link,menu-item,zone-caps" text="%main.link.forum" contentDisplay="RIGHT">
            <graphic><Region styleClass="external-arrow"/></graphic>
        </Label>
        <Label fx:id="support" id="linkSupport" styleClass="header-link,menu-item,zone-caps" text="%main.link.support" contentDisplay="RIGHT">
            <graphic><Region styleClass="external-arrow"/></graphic>
        </Label>
    </HBox>
    <VBox fx:id="communityMenu" id="communityMenu" styleClass="profile-menu,community-menu,zone-radius-md"
          visible="false" managed="false" accessibleText="%main.community.menu.a11y"/>
</HBox>
