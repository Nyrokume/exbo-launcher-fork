<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Install path dialog before the first (fake) download.
  Path is one selectable chip (folder glyph + path + «Обзор»), not a TextField with a second CAPS button under it.
  Flow layout (.modal-box) like logout_pane: card sized by content.
-->
<AnchorPane fx:id="installPane" styleClass="modal-layer" visible="false" stylesheets="@../../style/layout.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.modals.InstallModalController">
    <Region styleClass="modal-dim" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
    <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox fx:id="installCard" id="modal-installCard" styleClass="modal-box,zone-radius-md"
              maxWidth="-Infinity" maxHeight="-Infinity">
            <Label fx:id="installTitle" styleClass="modal-title,font-display" text="%main.modal.install.title"/>
            <Region styleClass="modal-box-rule"/>

            <Label fx:id="installDirLabel" styleClass="modal-text,install-space" wrapText="true" minHeight="-Infinity"
                   text="%main.modal.install.text"/>

            <HBox fx:id="installPathRow" styleClass="install-path,zone-radius-sm" alignment="CENTER_LEFT" spacing="10"
                  maxWidth="Infinity">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="12"/>
                </padding>
                <Region styleClass="install-path-icon" minWidth="16" prefWidth="16" maxWidth="16"
                        minHeight="14" prefHeight="14" maxHeight="14"/>
                <Label fx:id="installDir" styleClass="install-path-text" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       textOverrun="ELLIPSIS" wrapText="false"/>
                <Button fx:id="installChangeFolder" id="installFolder" mnemonicParsing="false"
                        styleClass="install-path-browse,zone-caps" text="%main.modal.install.change_folder"/>
            </HBox>

            <CheckBox fx:id="installLinkCheckBox" selected="true" text="%main.modal.install.link"/>

            <HBox styleClass="modal-actions" alignment="CENTER">
                <Button id="modal-installYes" fx:id="installYes" mnemonicParsing="false"
                        styleClass="modal-action,btn-primary,font-display,zone-radius-sm"
                        text="%main.modal.install.confirm"/>
                <Button id="modal-installNo" fx:id="installNo" mnemonicParsing="false"
                        styleClass="modal-action,btn-outline,font-display,zone-radius-sm"
                        text="%main.modal.install.cancel"/>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
