            fx:controller="dev.launcherfork.ui.screens.main.modals.LoadingModalController">
    <center>
        <ProgressIndicator fx:id="loadingIndicator" maxHeight="50" maxWidth="50" progress="-1"/>
    </center>
</BorderPane>
