<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- "Change user" confirmation (original logoutPane). -->
<AnchorPane fx:id="logoutPane" visible="false" stylesheets="@../../style/common.css,@../../style/main.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.modals.LogoutModalController">
    <Region styleClass="modal-dim" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <center>
            <Pane maxHeight="146" maxWidth="487">
                <Label fx:id="logoutTitle" styleClass="modal-title" text="%main.modal.logout.title"/>
                <ImageView layoutX="0" layoutY="40"><Image url="@../../style/image/line_settings_main.png"/></ImageView>
                <Label fx:id="logoutDesc" layoutY="55" styleClass="modal-text" text="%main.modal.logout.text"/>
                <ImageView layoutX="0" layoutY="85"><Image url="@../../style/image/line_settings_group.png"/></ImageView>
                <Button id="logoutButtonRight" fx:id="logoutButtonRight" layoutX="60" layoutY="140" prefHeight="46" prefWidth="160" styleClass="modal-button" text="%main.modal.logout.confirm"/>
                <Button id="logoutButtonLeft" fx:id="logoutButtonLeft" layoutX="230" layoutY="140" prefHeight="46" prefWidth="160" styleClass="modal-button" text="%main.modal.logout.cancel"/>
            </Pane>
        </center>
    </BorderPane>
</AnchorPane>
