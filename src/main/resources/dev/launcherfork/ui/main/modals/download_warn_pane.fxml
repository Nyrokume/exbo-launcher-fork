<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- "Another download is running" warning (original downloadWarnPane). -->
<AnchorPane fx:id="downloadWarnPane" styleClass="modal-layer" visible="false" stylesheets="@../../style/layout.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.modals.DownloadWarnModalController">
    <Region styleClass="modal-dim" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <center>
            <Pane styleClass="modal-card,zone-radius-md" maxHeight="200" maxWidth="750">
                <Label layoutX="150" layoutY="35" styleClass="modal-title,font-display" text="%main.modal.download_warn.title"/>
                <Label layoutX="150" layoutY="71" maxHeight="90" maxWidth="500" styleClass="modal-text" text="%main.modal.download_warn.desc" wrapText="true"/>
                <Region styleClass="modal-rule" layoutX="150" layoutY="68" prefWidth="440" prefHeight="1"/>
                <Button id="modal-downloadWarnYes" fx:id="downloadWarnYes" layoutX="200" layoutY="160" prefHeight="46" prefWidth="160" styleClass="modal-button,btn-primary,zone-caps,zone-radius-sm" text="%main.modal.download_warn.confirm"/>
                <Button id="modal-downloadWarnNo" fx:id="downloadWarnNo" layoutX="370" layoutY="160" prefHeight="46" prefWidth="160" styleClass="modal-button,tile,zone-caps,zone-radius-sm" text="%main.modal.download_warn.cancel"/>
            </Pane>
        </center>
    </BorderPane>
</AnchorPane>
