<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- "Delete game files?" confirmation (original deletionPane). Deletes nothing in the fork. -->
<AnchorPane fx:id="deletionPane" styleClass="modal-layer" visible="false" stylesheets="@../../style/layout.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.modals.DeletionModalController">
    <Region styleClass="modal-dim" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <center>
            <Pane styleClass="modal-card,zone-radius-md" maxHeight="146" maxWidth="487">
                <Label fx:id="deletionTitle" styleClass="modal-title,font-display" text="%main.modal.delete.title"/>
                <Region styleClass="modal-rule" layoutX="0" layoutY="40" prefWidth="440" prefHeight="1"/>
                <Label fx:id="deletionDesc" layoutY="50" prefWidth="480" styleClass="modal-text" text="%main.modal.delete.text"/>
                <Region styleClass="modal-rule-light" layoutX="0" layoutY="85" prefWidth="440" prefHeight="1"/>
                <Button id="modal-deletionYes" fx:id="deletionYes" layoutX="60" layoutY="140" prefHeight="46" prefWidth="160" styleClass="modal-button,btn-primary,zone-caps,zone-radius-sm" text="%main.modal.delete.confirm"/>
                <Button id="modal-deletionNo" fx:id="deletionNo" layoutX="230" layoutY="140" prefHeight="46" prefWidth="160" styleClass="modal-button,tile,zone-caps,zone-radius-sm" text="%main.modal.delete.cancel"/>
            </Pane>
        </center>
    </BorderPane>
</AnchorPane>
