<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- In-window error dialog (original exceptionPane). Used as the simple error-dialog stub. -->
<AnchorPane fx:id="exceptionPane" visible="false" stylesheets="@../../style/common.css,@../../style/main.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.launcherfork.ui.screens.main.modals.ExceptionModalController">
    <Region styleClass="modal-dim" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <center>
            <Pane maxHeight="200" maxWidth="750">
                <Label fx:id="exceptionTitle" layoutX="150" layoutY="35" styleClass="modal-title" text="ddededdede"/>
                <ImageView layoutX="10" layoutY="7"><Image url="@../../style/image/exception_icon.png"/></ImageView>
                <Label fx:id="exceptionDesc" layoutX="150" layoutY="71" maxHeight="90" maxWidth="500" styleClass="modal-text" text="ddededdede" wrapText="true"/>
                <ImageView layoutX="150" layoutY="68"><Image url="@../../style/image/line_settings_main.png"/></ImageView>
                <Button id="offlineButton" fx:id="exceptionButton" layoutX="225" layoutY="157" prefHeight="46" prefWidth="318" styleClass="modal-button" text="%main.modal.exception.ok"/>
            </Pane>
        </center>
    </BorderPane>
</AnchorPane>
