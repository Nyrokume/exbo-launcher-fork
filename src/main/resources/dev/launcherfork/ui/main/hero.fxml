<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Hero block: "WELCOME" + red tagline block + game description (from the selected Server). -->
<VBox fx:id="heroPane" id="hero" styleClass="hero" pickOnBounds="false" fillWidth="true"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.HeroController">
    <Label fx:id="heroTitle" id="heroTitle" text="%main.hero.welcome" styleClass="hero-title,font-display" minHeight="-Infinity" wrapText="true"/>
    <Label fx:id="heroTagline" id="heroTagline" text="TAGLINE" styleClass="hero-tagline,font-display,zone-radius-sm" minHeight="-Infinity" maxWidth="-Infinity"/>
    <Label fx:id="heroDescription" id="heroDescription" styleClass="hero-description" wrapText="true" maxWidth="500" minHeight="-Infinity"/>
</VBox>
