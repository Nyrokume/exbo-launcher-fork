<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Fixed-width sidebar: EXBO wordmark (text, no image), "— GAMES —" section label, game list (server_entry.fxml),
  account card (site "balance" card look, opens logout) and Settings at the bottom.
-->
<VBox fx:id="sidebar" id="sidebar" styleClass="sidebar" minWidth="253" prefWidth="253" maxWidth="253"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.ServersListController">
    <Label fx:id="logo" id="wordmark" text="EXBO" styleClass="wordmark,font-display-strong" minHeight="-Infinity"/>
    <HBox fx:id="gamesLabel" styleClass="section-label" alignment="CENTER">
        <Region styleClass="section-line" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="gamesLabelText" styleClass="section-label-text,zone-caps" text="%main.games.title"/>
        <Region styleClass="section-line" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
    <ScrollPane fx:id="serversPane" id="gamesList" styleClass="servers-scroll" VBox.vgrow="ALWAYS"
                hbarPolicy="NEVER" vbarPolicy="NEVER" fitToWidth="true"/>
    <Button fx:id="loginButton" id="accountCard" styleClass="account-card,zone-radius-md" mnemonicParsing="false"
            focusTraversable="false" maxWidth="Infinity" alignment="TOP_LEFT">
        <graphic>
            <StackPane alignment="TOP_LEFT">
                <Region styleClass="account-watermark" StackPane.alignment="CENTER_RIGHT"/>
                <VBox spacing="4">
                    <Label fx:id="accountName" styleClass="account-name,zone-caps" text="PLAYER"/>
                    <Label fx:id="accountAction" styleClass="account-action" text="%main.account.switch" contentDisplay="RIGHT">
                        <graphic><Region styleClass="arrow-right"/></graphic>
                    </Label>
                </VBox>
            </StackPane>
        </graphic>
    </Button>
    <Button fx:id="settingsButton" id="sidebarSettings" text="%main.settings" styleClass="sidebar-settings,zone-caps"
            mnemonicParsing="false" focusTraversable="false">
        <graphic><Region styleClass="gear-icon"/></graphic>
    </Button>
</VBox>
