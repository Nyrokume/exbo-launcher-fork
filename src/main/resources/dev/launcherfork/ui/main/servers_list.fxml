<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.LogoMark?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Fixed-width sidebar: EXBO logo (vector), "— GAMES —" section label, game list (server_entry.fxml) and Settings
  at the bottom. The account moved to the profile menu in the top-right corner (main/profile.fxml).
-->
<VBox fx:id="sidebar" id="sidebar" styleClass="sidebar" minWidth="253" prefWidth="253" maxWidth="253"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.ServersListController">
    <!-- vector logo (ui/style/image/exbo-logo.svg -> SVGPath nodes), filled with -foreground -->
    <LogoMark fx:id="logo" id="sidebarLogo" styleClass="sidebar-logo" logoWidth="170"/>
    <!-- section label kept in FXML for ids/tests but hidden: no chrome captions in the sidebar -->
    <HBox fx:id="gamesLabel" styleClass="section-label" alignment="CENTER" visible="false" managed="false">
        <Region styleClass="section-line" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="gamesLabelText" styleClass="section-label-text,zone-caps" text="%main.games.title"/>
        <Region styleClass="section-line" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
    <ScrollPane fx:id="serversPane" id="gamesList" styleClass="servers-scroll" VBox.vgrow="ALWAYS"
                hbarPolicy="NEVER" vbarPolicy="NEVER" fitToWidth="true"/>
    <Button fx:id="settingsButton" id="sidebarSettings" text="%main.settings" styleClass="sidebar-settings,zone-caps"
            mnemonicParsing="false" focusTraversable="false">
        <graphic><Region styleClass="gear-icon"/></graphic>
    </Button>
</VBox>
