<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Bottom bar: status text + progress (stretches), tools button, bracketed Play/Download button. -->
<HBox fx:id="defaultStatusPane" id="statusBar" styleClass="status-bar" alignment="BOTTOM_LEFT" spacing="15" pickOnBounds="false"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.StatusPaneController">
    <VBox spacing="5" alignment="BOTTOM_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity">
        <Text fx:id="downloadingStatus" id="playStatus" styleClass="play-status" text="status"/>
        <ProgressBar fx:id="progressBar" id="playProgress" styleClass="play-progress,zone-radius-sm" maxWidth="Infinity" progress="0.0"/>
    </VBox>
    <Button fx:id="clientSettingsButton" id="toolsButton" styleClass="tools-button,tile,zone-radius-sm" mnemonicParsing="false" focusTraversable="false">
        <graphic><Region styleClass="tools-icon"/></graphic>
    </Button>
    <Button fx:id="downloadButton" id="playButton" styleClass="play-button,btn-primary,zone-caps,zone-radius-sm" mnemonicParsing="false" text="BUTTON"/>
</HBox>
