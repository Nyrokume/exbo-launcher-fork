<?xml version="1.0" encoding="UTF-8"?>

<?import dev.launcherfork.ui.components.StalCoinMark?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Profile control (stalzone.com account menu): nickname + caret; dropdown with the site donate card
  (Баланс: 0 + coin / Пополнить счет → → /donate), «Пригласить друга» ↗, «Личный кабинет» ↗, «Выйти».
  The card floats under the button (ProfileController.placeMenu), managed="false".
-->
<VBox fx:id="profileRoot" id="profileRoot" styleClass="profile-root" alignment="TOP_RIGHT" pickOnBounds="false"
      stylesheets="@../style/layout.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.launcherfork.ui.screens.main.ProfileController">
    <Button fx:id="loginButton" id="profileButton" styleClass="profile-button,zone-radius-sm" mnemonicParsing="false"
            contentDisplay="RIGHT">
        <graphic>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="accountName" id="profileName" styleClass="profile-name,zone-caps" text="PLAYER"/>
                <Region fx:id="profileCaret" styleClass="profile-caret"/>
            </HBox>
        </graphic>
    </Button>
    <VBox fx:id="profileMenu" id="profileMenu" styleClass="profile-menu,zone-radius-md" visible="false" managed="false">
        <!-- one card like site .donate → /donate: balance + coin, then «Пополнить счет» + arrow -->
        <Button fx:id="topUp" id="profileMenuTopUp" styleClass="profile-donate,zone-radius-sm" mnemonicParsing="false"
                contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" accessibleText="%main.account.top_up">
            <graphic>
                <VBox styleClass="profile-donate-body" spacing="5" maxWidth="Infinity">
                    <HBox styleClass="profile-donate-balance" alignment="CENTER_LEFT" spacing="5">
                        <Label fx:id="balanceLabel" styleClass="profile-donate-balance-text" text="%main.account.balance"/>
                        <StalCoinMark coinSize="19"/>
                    </HBox>
                    <HBox styleClass="profile-donate-move" alignment="CENTER_LEFT" spacing="5">
                        <Label styleClass="profile-donate-move-text" text="%main.account.top_up"/>
                        <Region styleClass="profile-donate-arrow"/>
                    </HBox>
                </VBox>
            </graphic>
        </Button>
        <Button fx:id="inviteFriend" id="profileMenuInvite" styleClass="profile-menu-item,zone-radius-sm" text="%main.account.invite"
                mnemonicParsing="false" contentDisplay="RIGHT" maxWidth="Infinity">
            <graphic><Region styleClass="external-arrow"/></graphic>
        </Button>
        <Button fx:id="profile" id="profileMenuProfile" styleClass="profile-menu-item,zone-radius-sm" text="%main.account.profile"
                mnemonicParsing="false" contentDisplay="RIGHT" maxWidth="Infinity">
            <graphic><Region styleClass="external-arrow"/></graphic>
        </Button>
        <Region styleClass="profile-menu-rule"/>
        <Button fx:id="logout" id="profileMenuLogout" styleClass="profile-menu-item,danger,zone-radius-sm" text="%main.account.logout"
                mnemonicParsing="false" maxWidth="Infinity"/>
    </VBox>
</VBox>
