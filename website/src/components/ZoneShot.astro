---
interface Props {
	file: string;
	caption: string;
}
const { file, caption } = Astro.props;
const dev = import.meta.env.DEV;
const en = Astro.url.pathname.includes('/en/');
const src = `${import.meta.env.BASE_URL}__zone-shots/${file}`;
const unpublished = en
	? 'The site build does not publish this file.'
	: 'Сборка сайта этот файл не публикует.';
---
<figure class="zone-shot">
	<div class="zone-shot-bar">{caption}</div>
	{dev ? <img src={src} alt={caption} /> : null}
	<p class="zone-shot-path"><code>docs/screenshots/{file}</code></p>
	<figcaption>{caption}. {unpublished}</figcaption>
</figure>
