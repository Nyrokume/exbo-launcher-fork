---
interface Props {
	file: string;
	caption: string;
}
const { file, caption } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const src = `${base}__zone-shots/${file}`;
---
<figure class="zone-shot">
	<div class="zone-shot-bar">
		<span class="zone-shot-caption">{caption}</span>
		<code class="zone-shot-file">docs/screenshots/{file}</code>
	</div>
	<img src={src} alt={caption} />
</figure>
