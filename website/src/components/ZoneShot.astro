---
interface Props {
	file: string;
	caption: string;
}
const { file, caption } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const src = `${base}__zone-shots/${file}`;
---
<figure class="zone-shot">
	<div class="zone-shot-bar">{caption}</div>
	<img src={src} alt={caption} />
	<figcaption>
		{caption}. <code>docs/screenshots/{file}</code>
	</figcaption>
</figure>
